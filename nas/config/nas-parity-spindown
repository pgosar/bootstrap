#!/usr/bin/env bash
set -euo pipefail

config=/etc/default/nas-storage
[[ -r "$config" ]] || {
  echo "NAS storage config is unavailable: $config" >&2
  exit 1
}
# Generated by bootstrap-nas.sh from the reviewed private environment.
# shellcheck disable=SC1090
source "$config"
parity_disk="${PARITY_DISK:?PARITY_DISK is unset in $config}"
[[ -b "$parity_disk" ]] || {
  echo "parity disk is unavailable: $parity_disk" >&2
  exit 1
}

# 241 encodes a 30-minute idle timeout. SMART is configured not to wake
# standby drives; SnapRAID activity wakes this disk only in its maintenance window.
exec /usr/bin/hdparm -S 241 "$parity_disk"
