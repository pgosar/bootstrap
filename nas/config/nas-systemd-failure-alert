#!/usr/bin/env bash
# Notify once when the set of failed systemd units changes, and once on recovery.
set -euo pipefail

readonly STATE_DIR="${NAS_SYSTEMD_FAILURE_STATE_DIR:-/var/lib/nas-systemd-failure-alert}"
readonly STATE_FILE="$STATE_DIR/state.tsv"
readonly STATUS_FILE="$STATE_DIR/status.json"
readonly NO_NOTIFY="${NAS_SYSTEMD_FAILURE_ALERT_NO_NOTIFY:-false}"

install -d -m 0755 "$STATE_DIR"
tmp_state="$(mktemp --tmpdir="$STATE_DIR" .state.XXXXXX)"
tmp_status="$(mktemp --tmpdir="$STATE_DIR" .status.XXXXXX)"
tmp_recovered="$(mktemp --tmpdir="$STATE_DIR" .recovered.XXXXXX)"
cleanup() {
  rm -f -- "$tmp_state" "$tmp_status" "$tmp_recovered"
}
trap cleanup EXIT

while IFS= read -r unit; do
  [[ -n "$unit" ]] || continue
  case "$unit" in
    nas-container-health-alert.service | nas-systemd-failure-alert.service) continue ;;
  esac
  description="$(systemctl show "$unit" -p Description --value --no-pager)"
  result="$(systemctl show "$unit" -p Result --value --no-pager)"
  exit_status="$(systemctl show "$unit" -p ExecMainStatus --value --no-pager)"
  description="${description//$'\t'/ }"
  description="${description//$'\r'/ }"
  description="${description//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\n' \
    "$unit" "${result:-unknown}" "${exit_status:-unknown}" "${description:-$unit}"
done < <(
  systemctl list-units --failed --no-legend --plain --no-pager |
    awk 'NF {print $1}'
) | LC_ALL=C sort -t $'\t' -k1,1 >"$tmp_state"

previous=""
current="$(cat "$tmp_state")"
if [[ -f "$STATE_FILE" ]]; then
  previous="$(cat "$STATE_FILE")"
  comm -23 \
    <(cut -f1 "$STATE_FILE" | LC_ALL=C sort) \
    <(cut -f1 "$tmp_state" | LC_ALL=C sort) >"$tmp_recovered"
fi

if [[ "$current" != "$previous" && "$NO_NOTIFY" != "true" ]]; then
  if [[ -z "$current" ]]; then
    message='All monitored systemd units recovered.'
  else
    message=$'Systemd unit failures changed:\n'
    while IFS=$'\t' read -r unit result exit_status description; do
      message+="- $unit: $description (result=$result, exit=$exit_status)"
      message+=$'\n'
    done <"$tmp_state"
  fi
  if [[ -s "$tmp_recovered" ]]; then
    message+=$'Recovered:\n'
    while IFS= read -r unit; do
      message+="- $unit"
      message+=$'\n'
    done <"$tmp_recovered"
  fi
  /usr/local/sbin/nas-notify systemd "$message"
fi

jq -n \
  --arg checked_at "$(date -u +%FT%TZ)" \
  --slurpfile failures <(
    jq -Rn '[inputs | select(length > 0) | split("\t") | {
      unit: .[0], result: .[1], exit_status: .[2], description: .[3]
    }]' <"$tmp_state"
  ) \
  '{checked_at: $checked_at, healthy: ($failures[0] | length == 0), failures: $failures[0]}' \
  >"$tmp_status"
chmod 0644 "$tmp_state" "$tmp_status"
mv -f -- "$tmp_state" "$STATE_FILE"
mv -f -- "$tmp_status" "$STATUS_FILE"
