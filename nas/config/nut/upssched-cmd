#!/bin/bash
# Called by upssched on timer expiry (5 min on battery) or low battery.
# Triggers a graceful shutdown so the NAS never dies mid-write.
case "$1" in
  onbatt-shutdown|fast-shutdown)
    logger -t upssched "UPS event ($1): initiating graceful shutdown"
    /usr/bin/systemctl poweroff
    ;;
esac
