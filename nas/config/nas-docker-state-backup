#!/usr/bin/env bash
# Create cross-disk, versioned replicas of the latest Docker Btrfs snapshots.
set -euo pipefail

LOCK_FILE=/run/lock/snapraid-operation.lock
BTRBK_LOCK_FILE=/run/lock/nas-btrbk-operation.lock
BTRBK_LOCK_WAIT_SECONDS=1800
STORAGE_CONFIG=/etc/default/nas-storage

[[ -r "$STORAGE_CONFIG" ]] || {
  echo "NAS storage config is unavailable: $STORAGE_CONFIG" >&2
  exit 1
}
# Generated by bootstrap-nas.sh from the reviewed private environment.
# shellcheck disable=SC1090
source "$STORAGE_CONFIG"
backup_owner="${NAS_USER:?NAS_USER is unset in $STORAGE_CONFIG}"
backup_group="${NAS_GROUP:?NAS_GROUP is unset in $STORAGE_CONFIG}"

exec 8>"$BTRBK_LOCK_FILE"
if ! flock -n 8; then
  echo "Waiting up to ${BTRBK_LOCK_WAIT_SECONDS}s for another btrbk operation to finish."
  if ! flock -w "$BTRBK_LOCK_WAIT_SECONDS" 8; then
    echo "Docker-state backup failed: timed out waiting for $BTRBK_LOCK_FILE." >&2
    exit 1
  fi
  echo "Acquired the btrbk operation lock after waiting."
fi

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Docker-state backup skipped: SnapRAID or a Btrfs scrub is active."
  exit 0
fi

# Logical PostgreSQL archives make the two stateful application databases
# portable across PostgreSQL installations and versions. They are stored in
# disk1's Docker subvolume so the fresh btrbk snapshot below and the cross-disk
# replica both capture the same validated archives.
/usr/local/sbin/nas-database-backup

# A fresh immutable source avoids copying active SQLite/Postgres files directly.
btrbk -c /etc/btrbk/btrbk.conf run

latest_snapshot() {
  find "$1" -mindepth 1 -maxdepth 1 -type d -name 'docker.*' -printf '%T@ %p\n' |
    sort -n | tail -n 1 | cut -d' ' -f2-
}

backup_disk() {
  local source_disk="$1" target_disk="$2" source snapshot root next current previous
  source="/mnt/disk${source_disk}/snapshots"
  snapshot="$(latest_snapshot "$source")"
  [[ -n "$snapshot" ]] || { echo "No Docker snapshot found on disk${source_disk}" >&2; return 1; }

  root="/mnt/disk${target_disk}/pool/backups/docker-state/disk${source_disk}"
  next="$root/.next"
  current="$root/current"
  previous="$root/.previous"
  install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$root"
  rm -rf -- "$next" "$previous"
  install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$next"
  ionice -c 3 nice -n 10 rsync -aHAX --numeric-ids --delete --exclude='ipc-socket' "$snapshot/" "$next/"
  printf 'source_disk=disk%s\nsource_snapshot=%s\ncreated_at=%s\n' \
    "$source_disk" "$snapshot" "$(date -u +%FT%TZ)" >"$next/MANIFEST"
  chown -R "$backup_owner:$backup_group" "$next"
  [[ ! -d "$current" ]] || mv -- "$current" "$previous"
  mv -- "$next" "$current"
  rm -rf -- "$previous"
  echo "Backed up disk${source_disk} Docker state to $current"
}

# Never write a source disk's Docker state back to that same physical disk.
backup_disk 1 2
backup_disk 2 3
backup_disk 3 1

# NVMe-hosted application databases live outside the btrfs data-disk snapshots.
# Back them up with rsync, preserving numeric ownership (do NOT chown — database
# processes require specific UIDs, e.g. postgres 999). Replicated to all three
# data disks for cross-disk redundancy.
NVME_DB_DIRS=(
  /var/lib/immich-postgres
  /var/lib/tdarr-server
  /var/lib/scrutiny-influxdb
  /var/lib/sonarr
  /var/lib/radarr
  /var/lib/prowlarr
  /var/lib/jellyfin
)

backup_nvme_dbs() {
  local target_disk root next current previous created
  created="$(date -u +%FT%TZ)"
  for target_disk in 1 2 3; do
    root="/mnt/disk${target_disk}/pool/backups/nvme-db"
    next="$root/.next"
    current="$root/current"
    previous="$root/.previous"
    install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$root"
    rm -rf -- "$next" "$previous"
    install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$next"
    for src in "${NVME_DB_DIRS[@]}"; do
      [[ -d "$src" ]] || { echo "NVMe DB dir missing, skipping: $src" >&2; continue; }
      # --numeric-ids preserves the original UID/GID (critical for postgres 999).
      # No chown here — unlike docker-state above, DB ownership must survive.
      ionice -c 3 nice -n 10 rsync -aHAX --numeric-ids --delete "$src/" "$next/$(basename "$src")/"
    done
    printf created_at=%s\n "$created" >"$next/MANIFEST"
    # Root dir owned by backup user for browsability; contents keep real ownership.
    chown "$backup_owner:$backup_group" "$next"
    [[ ! -d "$current" ]] || mv -- "$current" "$previous"
    mv -- "$next" "$current"
    rm -rf -- "$previous"
    echo "Backed up NVMe DBs to $current"
  done
}

backup_nvme_dbs

# Logical PostgreSQL dumps (transaction-consistent, preferred recovery path).
backup_pg_dumps() {
  local target_disk root dest
  for target_disk in 1 2 3; do
    root="/mnt/disk${target_disk}/pool/backups/nvme-db/current"
    dest="$root/pg-dumps"
    install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$dest"
    docker exec immich_postgres sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists' >"$dest/immich.sql" 2>/dev/null && echo "pg_dump immich OK" || echo "pg_dump immich FAILED" >&2
    docker exec nextcloud_postgres sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists' >"$dest/nextcloud.sql" 2>/dev/null && echo "pg_dump nextcloud OK" || echo "pg_dump nextcloud FAILED" >&2
  done
}
# Transaction-consistent SQLite dumps via online backup API.
backup_sqlite_dumps() {
  local target_disk root dest
  for target_disk in 1 2 3; do
    root="/mnt/disk${target_disk}/pool/backups/nvme-db/current"
    dest="$root/sqlite-dumps"
    install -d -o "$backup_owner" -g "$backup_group" -m 2770 "$dest"
    for pair in "sonarr:/var/lib/sonarr/sonarr.db" "radarr:/var/lib/radarr/radarr.db" "prowlarr:/var/lib/prowlarr/prowlarr.db"; do
      n="${pair%%:*}"; db="${pair#*:}"
      [[ -f "$db" ]] && sqlite3 "$db" ".dump" >"$dest/${n}.sql" 2>/dev/null && echo "sqlite $n OK" || echo "sqlite $n FAILED" >&2
    done
  done
}

backup_pg_dumps
backup_sqlite_dumps
