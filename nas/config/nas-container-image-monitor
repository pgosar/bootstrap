#!/usr/bin/env bash
# Check tracked image channels against their pinned digests without
# recreating containers. The pull is detection-only (policy change,
# Oct 28, 2026): a downloaded newer copy is deleted again in the same
# run and the channel tag is pointed back at the pinned image, so
# updates are downloaded at pin-bump/rebuild time, not ahead of it.
set -euo pipefail

readonly DOCKER_ROOT="${NAS_CONTAINER_IMAGE_DOCKER_ROOT:-/data/docker}"
readonly STATE_DIR="${NAS_CONTAINER_IMAGE_STATE_DIR:-/var/lib/nas-container-image-monitor}"
readonly STATE_FILE="$STATE_DIR/state"
readonly STATUS_FILE="$STATE_DIR/status.json"
readonly NO_NOTIFY="${NAS_CONTAINER_IMAGE_MONITOR_NO_NOTIFY:-false}"

install -d -m 0755 "$STATE_DIR"
tmp_refs="$(mktemp)"
tmp_updates="$(mktemp)"
tmp_errors="$(mktemp)"
tmp_state="$(mktemp --tmpdir="$STATE_DIR" .state.XXXXXX)"
tmp_status="$(mktemp --tmpdir="$STATE_DIR" .status.XXXXXX)"
cleanup() {
  rm -f -- "$tmp_refs" "$tmp_updates" "$tmp_errors" "$tmp_state" "$tmp_status"
}
trap cleanup EXIT

# PC-only CUDA/worker images are pinned in Git but checked on that host; avoid
# downloading multi-gigabyte GPU images onto the NAS.
find "$DOCKER_ROOT/compose" -mindepth 2 -maxdepth 2 -name 'compose.yml' ! -path '*/pc-workers/*' -print0 |
  xargs -0 awk '$1 == "image:" {print $2}' >>"$tmp_refs"
find "$DOCKER_ROOT/compose" -name Dockerfile -print0 |
  xargs -0 awk '$1 == "FROM" {print $2}' >>"$tmp_refs"
sort -u "$tmp_refs" -o "$tmp_refs"

while IFS= read -r pinned_ref; do
  [[ "$pinned_ref" == *@sha256:* ]] || continue
  channel="${pinned_ref%@sha256:*}"
  pinned_digest="sha256:${pinned_ref##*@sha256:}"
  if ! docker pull --quiet "$channel" >/dev/null; then
    printf '%s\tpull failed\n' "$channel" >>"$tmp_errors"
    continue
  fi
  pulled_id="$(docker image inspect "$channel" --format '{{.Id}}')"
  available_digest="$(docker image inspect "$channel" --format '{{range .RepoDigests}}{{println .}}{{end}}' |
    awk -v repository="${channel%:*}" -F '@' '$1 == repository || $1 == "docker.io/" repository || $1 == "docker.io/library/" repository {print $2; exit}')"
  if [[ -z "$available_digest" ]]; then
    available_digest="$(docker image inspect "$channel" --format '{{index .RepoDigests 0}}' | awk -F '@' '{print $2}')"
  fi
  # Detection-only cleanup: drop the copy this run downloaded and point
  # the channel tag back at the pinned image, if it is present locally.
  pinned_id="$(docker image inspect "$pinned_ref" --format '{{.Id}}' 2>/dev/null || true)"
  if [[ -n "$pulled_id" && "$pulled_id" != "$pinned_id" ]]; then
    docker image rm "$pulled_id" >/dev/null 2>&1 || true
    if [[ -n "$pinned_id" ]]; then
      docker tag "$pinned_id" "$channel" >/dev/null 2>&1 || true
    fi
  fi
  if [[ -z "$available_digest" ]]; then
    printf '%s\tregistry digest unavailable\n' "$channel" >>"$tmp_errors"
  elif [[ "$available_digest" != "$pinned_digest" ]]; then
    printf '%s\t%s\t%s\n' "$channel" "$pinned_digest" "$available_digest" >>"$tmp_updates"
  fi
done <"$tmp_refs"

sort -u "$tmp_updates" -o "$tmp_updates"
sort -u "$tmp_errors" -o "$tmp_errors"
{ cat "$tmp_updates"; cat "$tmp_errors"; } >"$tmp_state"
chmod 0644 "$tmp_state"
previous=""
[[ ! -f "$STATE_FILE" ]] || previous="$(cat "$STATE_FILE")"
current="$(cat "$tmp_state")"

if [[ "$current" != "$previous" && "$NO_NOTIFY" != "true" ]]; then
  if [[ -z "$current" ]]; then
    /usr/local/sbin/nas-notify container-images 'Pinned container images now match their tracked release channels.'
  else
    update_count="$(wc -l <"$tmp_updates")"
    error_count="$(wc -l <"$tmp_errors")"
    message="Container image review: $update_count update(s) available, $error_count registry error(s)."
    if [[ "$update_count" -gt 0 ]]; then
      message+=$'\nUpdates:'
      while IFS=$'\t' read -r channel _; do message+=$'\n- '; message+="$channel"; done <"$tmp_updates"
    fi
    if [[ "$error_count" -gt 0 ]]; then
      message+=$'\nErrors:'
      while IFS=$'\t' read -r channel reason; do message+=$'\n- '; message+="$channel: $reason"; done <"$tmp_errors"
    fi
    /usr/local/sbin/nas-notify container-images "$message"
  fi
fi

jq -n \
  --arg checked_at "$(date -u +%FT%TZ)" \
  --slurpfile updates <(jq -Rn '[inputs | select(length > 0) | split("\t") | {image: .[0], pinned_digest: .[1], available_digest: .[2]}]' <"$tmp_updates") \
  --slurpfile errors <(jq -Rn '[inputs | select(length > 0) | split("\t") | {image: .[0], error: .[1]}]' <"$tmp_errors") \
  '{checked_at: $checked_at, updates_available: ($updates[0] | length), updates: $updates[0], errors: $errors[0]}' >"$tmp_status"
chmod 0644 "$tmp_status"
mv -f -- "$tmp_state" "$STATE_FILE"
mv -f -- "$tmp_status" "$STATUS_FILE"

# Registry failures are first-class monitor results recorded above, not script
# failures. Reserve a nonzero service result for an unexpected script or
# notification failure so routine throttling does not poison systemd health.
exit 0
