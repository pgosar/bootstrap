[Unit]
Description=IGMP general querier (keeps multicast group memberships fresh for mDNS/HomeKit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/igmp-querier.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
