[Unit]
Description=Amazon product search/cart/orders API (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__NAS_USER__
WorkingDirectory=/home/__NAS_USER__/code/muse-amazon-bypass
EnvironmentFile=/home/__NAS_USER__/.amazon-cart/env
ExecStart=/home/__NAS_USER__/code/muse-amazon-bypass/.venv/bin/amazon-cart
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
