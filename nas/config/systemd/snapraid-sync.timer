[Unit]
Description=Run SnapRAID sync about every 12 hours

[Timer]
# Overnight sync runs Mon-Sat 02:15 and daily 15:15. The weekly scrub now
# runs Saturday 16:15, right after the afternoon sync.
OnCalendar=Mon..Sat *-*-* 02:15:00
OnCalendar=*-*-* 15:15:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
