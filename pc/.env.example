# .env is local and must not be committed.
# Do not put secrets in .env.
# Use /dev/disk/by-id paths on real hardware.
# Set DISK_LAYOUT_REVIEWED=true only after reviewing disk mapping.
# Use ALLOW_QEMU_DEVICE_NAMES=true only in QEMU tests.

# Host identity
PC_HOSTNAME="REPLACE_ME_HOSTNAME"
PC_USER="REPLACE_ME_USERNAME"

# Locale / time
TIMEZONE="America/Los_Angeles"
LOCALE="en_US.UTF-8"
KEYMAP="us"

# Install target
TARGET_MODE="host"
TARGET_ROOT="/mnt"

# Boot / OS disk
OS_DISK="/dev/disk/by-id/REPLACE_ME_OS_DISK"
EFI_PARTITION="/dev/disk/by-id/REPLACE_ME_OS_DISK-part1"
ROOT_PARTITION="/dev/disk/by-id/REPLACE_ME_OS_DISK-part2"

# Bootloader / kernel
BOOTLOADER="grub"
GRUB_BOOTLOADER_ID="cachyos"
KERNEL_PACKAGE="linux-cachyos"
KERNEL_HEADERS_PACKAGE="linux-cachyos-headers"
MICROCODE_PACKAGE="amd-ucode"
INSTALL_MICROCODE="true"

# Btrfs layout
BTRFS_OS_MOUNT_OPTS="rw,noatime,compress=zstd:1"
OS_SUBVOL_TEMP_MOUNT="/run/pc-bootstrap-rootfs"

# Safety
ALLOW_RAW_DEV_PATHS="false"
ALLOW_QEMU_DEVICE_NAMES="false"
DISK_LAYOUT_REVIEWED="false"
VALIDATE_WRITE_TESTS="true"

# Feature toggles
ENABLE_UFW="true"
KDECONNECT_LAN_CIDR="192.168.1.0/24"
ENABLE_SYSTEMD_TIMESYNCD="true"
ENABLE_SYSTEMD_RESOLVED="true"
ENABLE_NETWORKMANAGER="true"
ENABLE_BLUETOOTH="true"
ENABLE_LIBVIRTD="true"
ENABLE_PLASMALOGIN="true"
ENABLE_AVAHI="true"
ENABLE_FSTRIM_TIMER="true"
ENABLE_SMARTD="false"
ENABLE_NFTABLES="false"
ENABLE_PODMAN="true"
ENABLE_DISTROBOX="true"
ENABLE_FIREFOX="true"
ENABLE_ZSH="true"
ENABLE_TAILSCALED="true"
ENABLE_DOCKER="true"
ENABLE_KEYD="true"
ENABLE_LACTD="true"
ENABLE_SSH_INHIBIT="true"
ENABLE_RAM_RGB="true"
ENABLE_PC_WOL="true"
ENABLE_PC_WORKERS="true"
ENABLE_BPFTUNE="true"
ENABLE_NVIDIA_SUSPEND_HOOKS="true"
ENABLE_SNAPPER_TIMELINE="false"
ENABLE_SYSTEMD_OOMD="false"
SETUP_DOTFILES="true"
# NAS share mounts (fstab CIFS) + static IP. NAS_CREDS_SOURCE is a path to a
# local credentials file (username=/password= lines) copied to /etc/.nascreds;
# never commit the credentials themselves.
NAS_SERVER_IP="192.168.1.218"
NAS_CREDS_SOURCE=""
PC_STATIC_ADDRESS="192.168.1.50/24"
PC_GATEWAY="192.168.1.254"
PC_DNS="1.1.1.1;8.8.8.8;"
START_SERVICES_AFTER_ENABLE="false"

# User groups
USER_SUPPLEMENTAL_GROUPS=(
  "wheel"
  "network"
  "libvirt"
  "audio"
  "video"
  "storage"
  "lp"
  "rfkill"
  "docker"
  "users"
  "nopasswdlogin"
  "sys"
  "input"
  "gamemode"
)
