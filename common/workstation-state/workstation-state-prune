#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: workstation-state-prune STATE_ROOT [RETENTION_DAYS] [--dry-run]

Remove timestamped workstation-state snapshot directories older than the
retention window. Deletion is confined to descendants of STATE_ROOT whose
basename exactly matches the recorder's UTC timestamp format.
EOF
}

[[ $# -ge 1 && $# -le 3 ]] || { usage >&2; exit 2; }
state_root="$1"
retention_days="${2:-30}"
mode="${3:-}"
[[ -z "$mode" || "$mode" == --dry-run ]] || { usage >&2; exit 2; }
[[ "$state_root" == /* && -d "$state_root" ]] || {
  printf 'state root must be an existing absolute directory: %s\n' "$state_root" >&2
  exit 2
}
[[ "$retention_days" =~ ^[1-9][0-9]*$ ]] || {
  printf 'retention days must be a positive integer: %s\n' "$retention_days" >&2
  exit 2
}

state_root="$(realpath -e -- "$state_root")"
case "${state_root##*/}" in
  system-state|workstation-state) ;;
  *)
    printf 'refusing unexpected state root: %s\n' "$state_root" >&2
    exit 2
    ;;
esac
readonly state_root retention_days mode
readonly cutoff_epoch="$(( $(date -u +%s) - retention_days * 86400 ))"
removed=0
would_remove=0

while IFS= read -r -d '' candidate; do
  snapshot="$(realpath -e -- "$candidate")"
  name="${snapshot##*/}"
  [[ "$name" =~ ^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z$ ]] || continue
  case "$snapshot" in
    "$state_root"/*/*|"$state_root"/*/*/*) ;;
    *)
      printf 'refusing snapshot outside guarded depth: %s\n' "$snapshot" >&2
      exit 1
      ;;
  esac
  snapshot_epoch="$(date -u -d "${name:0:10} ${name:11:2}:${name:13:2}:${name:15:2}" +%s 2>/dev/null || true)"
  [[ -n "$snapshot_epoch" ]] || {
    printf 'refusing invalid snapshot timestamp: %s\n' "$snapshot" >&2
    exit 1
  }
  (( snapshot_epoch < cutoff_epoch )) || continue
  if [[ "$mode" == --dry-run ]]; then
    printf 'would remove %s\n' "$snapshot"
    would_remove=$((would_remove + 1))
  else
    printf 'removing %s\n' "$snapshot"
    rm -rf --one-file-system -- "$snapshot"
    removed=$((removed + 1))
  fi
done < <(find "$state_root" -mindepth 2 -maxdepth 3 -type d -name '20??-??-??T??????Z' -print0)

if [[ "$mode" != --dry-run ]]; then
  while IFS= read -r -d '' latest; do
    parent="${latest%/latest}"
    newest="$(find "$parent" -mindepth 1 -maxdepth 1 -type d -name '20??-??-??T??????Z' -printf '%f\n' | LC_ALL=C sort | tail -n1)"
    if [[ -n "$newest" ]]; then
      ln -sfn "$newest" "$latest"
    else
      rm -f -- "$latest"
    fi
  done < <(find "$state_root" -mindepth 2 -maxdepth 3 -type l -name latest -print0)
fi

printf 'retention_days=%s removed=%s would_remove=%s\n' "$retention_days" "$removed" "$would_remove"
