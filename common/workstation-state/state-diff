#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: state-diff HOST FROM TO [--brief]

Compare two timestamped workstation-state snapshots. Date references resolve
to the newest snapshot at or before that date; today/latest select the newest
snapshot and previous selects the snapshot immediately before it.

Environment:
  WORKSTATION_STATE_ROOT  Snapshot root (default: /data/personal/system-state)
  STATE_DIFF_MAX_ITEMS   Maximum detailed changes to print (default: 80)
EOF
}

[[ $# -ge 3 && $# -le 4 ]] || { usage >&2; exit 2; }
readonly HOST_LABEL="$1"
readonly FROM_REF="$2"
readonly TO_REF="$3"
readonly MODE="${4:-}"
[[ -z "$MODE" || "$MODE" == --brief ]] || { usage >&2; exit 2; }
readonly STATE_ROOT="${WORKSTATION_STATE_ROOT:-/data/personal/system-state}"
readonly HOST_ROOT="$STATE_ROOT/$HOST_LABEL"
readonly MAX_ITEMS="${STATE_DIFF_MAX_ITEMS:-80}"
[[ -d "$HOST_ROOT" ]] || { printf 'no snapshots for host %s under %s\n' "$HOST_LABEL" "$STATE_ROOT" >&2; exit 1; }

mapfile -t snapshots < <(find "$HOST_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20??-??-??T??????Z' -printf '%f\n' | LC_ALL=C sort)
(( ${#snapshots[@]} > 0 )) || { printf 'no snapshots for host %s\n' "$HOST_LABEL" >&2; exit 1; }

resolve_snapshot() {
  local ref="$1" target candidate="" stamp epoch
  case "$ref" in
    today|latest) printf '%s\n' "${snapshots[-1]}"; return 0 ;;
    previous)
      (( ${#snapshots[@]} >= 2 )) || return 1
      printf '%s\n' "${snapshots[-2]}"
      return 0
      ;;
  esac
  if [[ "$ref" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    target="$(date -d "$ref 23:59:59" +%s)"
  else
    target="$(date -d "$ref" +%s 2>/dev/null)" || return 1
  fi
  for stamp in "${snapshots[@]}"; do
    epoch="$(date -u -d "${stamp:0:4}-${stamp:5:2}-${stamp:8:2} ${stamp:11:2}:${stamp:13:2}:${stamp:15:2}" +%s 2>/dev/null || true)"
    [[ -n "$epoch" ]] || continue
    (( epoch <= target )) && candidate="$stamp"
  done
  printf '%s\n' "${candidate:-${snapshots[0]}}"
}

from_snapshot="$(resolve_snapshot "$FROM_REF")" || { printf 'cannot resolve snapshot: %s\n' "$FROM_REF" >&2; exit 1; }
to_snapshot="$(resolve_snapshot "$TO_REF")" || { printf 'cannot resolve snapshot: %s\n' "$TO_REF" >&2; exit 1; }
readonly FROM_DIR="$HOST_ROOT/$from_snapshot"
readonly TO_DIR="$HOST_ROOT/$to_snapshot"

readonly TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
total_added=0
total_removed=0
total_changed=0
printed=0
summary_parts=()

compare_component() {
  local label="$1" file="$2" old new
  old="$FROM_DIR/$file"
  new="$TO_DIR/$file"
  local added removed changed key old_value new_value
  local old_map="$TMP_DIR/$file.old" new_map="$TMP_DIR/$file.new"
  [[ -f "$old" ]] || old=/dev/null
  [[ -f "$new" ]] || new=/dev/null
  awk -F '\t' 'NF {key=$1; value=$0; sub(/^[^\t]*\t?/, "", value); print key "\t" value}' "$old" | LC_ALL=C sort -t $'\t' -k1,1 >"$old_map"
  awk -F '\t' 'NF {key=$1; value=$0; sub(/^[^\t]*\t?/, "", value); print key "\t" value}' "$new" | LC_ALL=C sort -t $'\t' -k1,1 >"$new_map"
  added="$(awk -F '\t' 'NR==FNR {old[$1]=1; next} !($1 in old) {count++} END {print count+0}' "$old_map" "$new_map")"
  removed="$(awk -F '\t' 'NR==FNR {new[$1]=1; next} !($1 in new) {count++} END {print count+0}' "$new_map" "$old_map")"
  changed="$(awk -F '\t' 'NR==FNR {key=$1; value=$0; sub(/^[^\t]*\t?/, "", value); old[key]=value; next} {key=$1; value=$0; sub(/^[^\t]*\t?/, "", value); if (key in old && old[key] != value) count++} END {print count+0}' "$old_map" "$new_map")"
  (( added + removed + changed > 0 )) || return 0
  total_added=$((total_added + added))
  total_removed=$((total_removed + removed))
  total_changed=$((total_changed + changed))
  summary_parts+=("$label +$added -$removed ~$changed")
  [[ "$MODE" == --brief ]] && return 0
  printf '\n%s: +%s -%s ~%s\n' "$label" "$added" "$removed" "$changed"
  while IFS=$'\t' read -r key new_value; do
    grep -Fq "$key"$'\t' "$old_map" && continue
    (( printed < MAX_ITEMS )) && printf '  + %s: %s\n' "$key" "$new_value"
    printed=$((printed + 1))
  done <"$new_map"
  while IFS=$'\t' read -r key old_value; do
    grep -Fq "$key"$'\t' "$new_map" && continue
    (( printed < MAX_ITEMS )) && printf '  - %s: %s\n' "$key" "$old_value"
    printed=$((printed + 1))
  done <"$old_map"
  while IFS=$'\t' read -r key old_value; do
    new_value="$(awk -F '\t' -v key="$key" '$1 == key {value=$0; sub(/^[^\t]*\t?/, "", value); print value; exit}' "$new_map")"
    [[ -n "$new_value" && "$old_value" != "$new_value" ]] || continue
    (( printed < MAX_ITEMS )) && printf '  ~ %s: %s -> %s\n' "$key" "$old_value" "$new_value"
    printed=$((printed + 1))
  done <"$old_map"
}

components=(
  'packages|packages.tsv'
  'AUR packages|aur-packages.tsv'
  'system services|system-services.tsv'
  'user services|user-services.tsv'
  'kernel|kernel.tsv'
  'GPU|gpu.tsv'
  'disks|disks.tsv'
  'mounts|mounts.tsv'
  '/etc files|etc-files.tsv'
  'Flatpaks|flatpaks.tsv'
  'Docker containers|docker-containers.tsv'
  'firmware|firmware.tsv'
  'hardware|hardware.tsv'
)

if [[ "$MODE" != --brief ]]; then
  printf 'State diff for %s\n' "$HOST_LABEL"
  printf '  from %s (requested: %s)\n' "$from_snapshot" "$FROM_REF"
  printf '  to   %s (requested: %s)\n' "$to_snapshot" "$TO_REF"
fi
for component in "${components[@]}"; do
  compare_component "${component%%|*}" "${component#*|}"
done

total=$((total_added + total_removed + total_changed))
if [[ "$MODE" == --brief ]]; then
  if (( total == 0 )); then
    printf '%s: no changes (%s to %s)\n' "$HOST_LABEL" "${from_snapshot:0:10}" "${to_snapshot:0:10}"
  else
    joined="$(IFS='; '; printf '%s' "${summary_parts[*]}")"
    printf '%s: %s changes (%s to %s): %s\n' "$HOST_LABEL" "$total" "${from_snapshot:0:10}" "${to_snapshot:0:10}" "$joined"
  fi
else
  printf '\nTotal: %s added, %s removed, %s changed\n' "$total_added" "$total_removed" "$total_changed"
  (( printed <= MAX_ITEMS )) || printf 'Details truncated after %s items.\n' "$MAX_ITEMS"
fi
